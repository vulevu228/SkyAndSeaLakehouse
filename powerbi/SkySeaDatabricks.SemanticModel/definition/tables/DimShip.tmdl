				    Kept = Table.SelectColumns(Data, {"mmsi", "ship_name", "ship_category", "is_seagoing", "length_m", "mmsi_kind"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"mmsi", type text}, {"ship_name", type text}, {"ship_category", type text}, {"is_seagoing", type logical}, {"length_m", type number}, {"mmsi_kind", type text}}),
				    #"Added ship_group" = Table.AddColumn(Typed, "ship_group", each if List.Contains({"cargo"}, [ship_category]) then "Cargo" else if List.Contains({"tanker"}, [ship_category]) then "Tanker" else if List.Contains({"passenger"}, [ship_category]) then "Passenger" else if List.Contains({"fishing"}, [ship_category]) then "Fishing" else if List.Contains({"tug", "towing", "pilot", "port tender", "search and rescue", "law enforcement", "anti-pollution", "medical transport", "dredging / underwater ops", "diving ops"}, [ship_category]) then "Tug & service" else if List.Contains({"sailing", "pleasure craft"}, [ship_category]) then "Leisure" else "Other", type text),
