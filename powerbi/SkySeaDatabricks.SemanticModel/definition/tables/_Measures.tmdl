	measure 'Focus Spec Bars' =
			VAR ft = [Focus Type]
			VAR S = CALCULATE(MAX(DimAircraftType[wingspan_m]), REMOVEFILTERS(DimAircraftType), DimAircraftType[typecode] = ft)
			VAR L = CALCULATE(MAX(DimAircraftType[length_m]), REMOVEFILTERS(DimAircraftType), DimAircraftType[typecode] = ft)
			VAR T = CALCULATE(MAX(DimAircraftType[mtow_kg]), REMOVEFILTERS(DimAircraftType), DimAircraftType[typecode] = ft) / 1000
			RETURN "data:image/svg+xml;utf8," & "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 250 150'>" & "<text x='" & FORMAT(0, "0.00", "en-US") & "' y='" & FORMAT(16, "0.00", "en-US") & "' font-family='Segoe UI' font-size='" & FORMAT(12, "0.00", "en-US") & "' font-weight='400' fill='%238A94A1' text-anchor='start'>" & "Wingspan" & "</text>" & "<text x='" & FORMAT(250, "0.00", "en-US") & "' y='" & FORMAT(16, "0.00", "en-US") & "' font-family='Segoe UI' font-size='" & FORMAT(12, "0.00", "en-US") & "' font-weight='600' fill='%23111418' text-anchor='end'>" & IF(ISBLANK(S), "n/a", FORMAT(S, "#,##0.0", "en-US") & " / 79.8" & " m") & "</text>" & "<rect x='0' y='25' width='250' height='5' rx='2.5' fill='%23E3E7EC'/>" & "<rect x='0' y='25' width='" & FORMAT(250 * MIN(1, DIVIDE(S, 79.8, 0)), "0.00", "en-US") & "' height='5' rx='2.5' fill='%2316191D'/>" & "<text x='" & FORMAT(0, "0.00", "en-US") & "' y='" & FORMAT(64, "0.00", "en-US") & "' font-family='Segoe UI' font-size='" & FORMAT(12, "0.00", "en-US") & "' font-weight='400' fill='%238A94A1' text-anchor='start'>" & "Length" & "</text>" & "<text x='" & FORMAT(250, "0.00", "en-US") & "' y='" & FORMAT(64, "0.00", "en-US") & "' font-family='Segoe UI' font-size='" & FORMAT(12, "0.00", "en-US") & "' font-weight='600' fill='%23111418' text-anchor='end'>" & IF(ISBLANK(L), "n/a", FORMAT(L, "#,##0.0", "en-US") & " / 72.7" & " m") & "</text>" & "<rect x='0' y='73' width='250' height='5' rx='2.5' fill='%23E3E7EC'/>" & "<rect x='0' y='73' width='" & FORMAT(250 * MIN(1, DIVIDE(L, 72.7, 0)), "0.00", "en-US") & "' height='5' rx='2.5' fill='%2316191D'/>" & "<text x='" & FORMAT(0, "0.00", "en-US") & "' y='" & FORMAT(112, "0.00", "en-US") & "' font-family='Segoe UI' font-size='" & FORMAT(12, "0.00", "en-US") & "' font-weight='400' fill='%238A94A1' text-anchor='start'>" & "Max take-off weight" & "</text>" & "<text x='" & FORMAT(250, "0.00", "en-US") & "' y='" & FORMAT(112, "0.00", "en-US") & "' font-family='Segoe UI' font-size='" & FORMAT(12, "0.00", "en-US") & "' font-weight='600' fill='%23111418' text-anchor='end'>" & IF(ISBLANK(T), "n/a", FORMAT(T, "#,##0.0", "en-US") & " / 575" & " t") & "</text>" & "<rect x='0' y='121' width='250' height='5' rx='2.5' fill='%23E3E7EC'/>" & "<rect x='0' y='121' width='" & FORMAT(250 * MIN(1, DIVIDE(T, 575, 0)), "0.00", "en-US") & "' height='5' rx='2.5' fill='%2316191D'/>" & "</svg>"
		displayFolder: 2 Aircraft
		lineageTag: 3e0f0a13-b625-5c72-8dbc-8ca686b47110
		dataCategory: ImageUrl

	measure 'Top Types' =
			VAR N = SELECTEDVALUE(DimAircraftType[model_name])
			VAR V = [Type Aircraft]
			RETURN IF(ISBLANK(N) || ISBLANK(V) || N = "Unknown type", BLANK(),
			    VAR R = RANKX(FILTER(ALLSELECTED(DimAircraftType[model_name]), DimAircraftType[model_name] <> "Unknown type" && NOT ISBLANK([Type Aircraft])), [Type Aircraft], V, DESC)
			    RETURN IF(R <= 20, V))
		formatString: #,##0
		displayFolder: 2 Aircraft
		lineageTag: 1fa99f7d-7358-5783-a2d6-fffede32de7b

	measure 'Type Bar Color' = IF(SELECTEDVALUE(DimAircraftType[model_name]) = CALCULATE([Focus Model], ALLSELECTED(DimAircraftType[model_name])), "#16191D", "#2A78D6")
		displayFolder: 2 Aircraft
		lineageTag: a32fc0f5-c7bc-510d-87ec-970808618d42

	measure 'Focus Operators' =
			// the focus type must not depend on the operator row (each operator would find its own top type)
			VAR ft = CALCULATE([Focus Type], REMOVEFILTERS(DimAircraft[operator]))
			VAR op = SELECTEDVALUE(DimAircraft[operator])
			VAR V = CALCULATE([Type Aircraft], REMOVEFILTERS(DimAircraftType), DimAircraftType[typecode] = ft)
			RETURN IF(ISBLANK(op) || ISBLANK(V), BLANK(),
			    VAR R = RANKX(FILTER(ALLSELECTED(DimAircraft[operator]), NOT ISBLANK(DimAircraft[operator]) && NOT ISBLANK(CALCULATE([Type Aircraft], REMOVEFILTERS(DimAircraftType), DimAircraftType[typecode] = ft))),
			        CALCULATE([Type Aircraft], REMOVEFILTERS(DimAircraftType), DimAircraftType[typecode] = ft), V, DESC)
			    RETURN IF(R <= 6, V))
		formatString: #,##0
		displayFolder: 2 Aircraft
		lineageTag: a65d0fc9-198c-5da5-89f1-cdbeb9fa1e2b

	measure 'Operators Title' = "Who flies the " & [Focus Model]
		displayFolder: 2 Aircraft
		lineageTag: 13b8772c-a065-58ec-b69e-11ffa622e823

	measure 'Focus Port' =
			VAR p = SELECTEDVALUE(PortPick[locode])
			RETURN IF(ISBLANK(p), "DEHAM", p)
		displayFolder: 3 Sea
		lineageTag: 70442571-1e86-5c1d-94a8-3a76f154c4bb

	measure Calls = CALCULATE(COUNTROWS(FactPortCalls), FactPortCalls[is_seagoing] = TRUE(), NOT ISBLANK(FactPortCalls[locode]))
		formatString: #,##0
		displayFolder: 3 Sea
		lineageTag: aaa6e258-fbea-5346-bb3b-7d42c79de595

	measure 'Dwell Median' = CALCULATE(MEDIAN(FactPortCalls[duration_h]), FactPortCalls[is_seagoing] = TRUE(), NOT ISBLANK(FactPortCalls[locode]), FactPortCalls[is_truncated] = FALSE())
		formatString: 0.0
		displayFolder: 3 Sea
		lineageTag: 25367e1f-5754-57bf-856d-8a0cdadad041

	measure 'Long Stays' = CALCULATE([Calls], FactPortCalls[duration_h] >= 48)
		formatString: #,##0
		displayFolder: 3 Sea
		lineageTag: 9a43d80d-2d30-5d3b-8fb4-daf91072f18b

	measure 'Port Ships' = CALCULATE(DISTINCTCOUNT(FactPortCalls[mmsi]), FactPortCalls[is_seagoing] = TRUE(), NOT ISBLANK(FactPortCalls[locode]))
		formatString: #,##0
		displayFolder: 3 Sea
		lineageTag: 8af72e91-6cf4-5460-84e9-da3ec4b32b49

	measure 'Focus Calls' = CALCULATE([Calls], TREATAS({[Focus Port]}, DimPort[locode]))
		formatString: #,##0
		displayFolder: 3 Sea
		lineageTag: d723f26a-9a6b-59e7-a2a9-adf156369480

	measure 'Focus Dwell Median' = CALCULATE([Dwell Median], TREATAS({[Focus Port]}, DimPort[locode]))
		formatString: 0.0
		displayFolder: 3 Sea
		lineageTag: 8db1ba0a-8001-52ee-bce6-023c8b754938

	measure 'Focus Long Stays' = CALCULATE([Long Stays], TREATAS({[Focus Port]}, DimPort[locode]))
		formatString: #,##0
		displayFolder: 3 Sea
		lineageTag: b6bbb95c-ede1-50fc-8c9b-040014933949

	measure 'Focus Port Ships' = CALCULATE([Port Ships], TREATAS({[Focus Port]}, DimPort[locode]))
		formatString: #,##0
		displayFolder: 3 Sea
		lineageTag: f596a880-da1e-5e28-9c4c-e3cdba33cacc

	measure 'All Ports Dwell Median' = CALCULATE([Dwell Median], REMOVEFILTERS(DimPort))
		formatString: 0.0
		displayFolder: 3 Sea
		lineageTag: 1ebdc526-d245-5c81-bd5e-a3569ecff45f

	measure 'Focus Port Name' =
			VAR p = [Focus Port]
			RETURN CALCULATE(MAX(DimPort[port_name]), REMOVEFILTERS(DimPort), DimPort[locode] = p)
		displayFolder: 3 Sea
		lineageTag: c7a1d9f7-d328-57f8-bab9-f9c19fea2e60

	measure 'Focus Port Sub' =
			VAR p = [Focus Port]
			RETURN p & "  ·  " & CALCULATE(MAX(DimPort[country]), REMOVEFILTERS(DimPort), DimPort[locode] = p) & "  ·  " & SUBSTITUTE(FORMAT([Focus Calls], "#,##0", "en-GB"), ",", UNICHAR(8239)) & " seagoing calls by " & SUBSTITUTE(FORMAT([Focus Port Ships], "#,##0", "en-GB"), ",", UNICHAR(8239)) & " ships"
		displayFolder: 3 Sea
		lineageTag: 3b928c3b-2e51-5421-95ea-cd094ef782f8

	measure 'Focus Dwell Text' = IF(ISBLANK([Focus Dwell Median]), "–", FORMAT([Focus Dwell Median], "0.0") & " h")
		displayFolder: 3 Sea
		lineageTag: 5dbc9d5b-9338-5932-ab0b-0ec7b141171f

	measure 'Focus Dwell Compare' =
			VAR d = [Focus Dwell Median]
			VAR a = [All Ports Dwell Median]
			RETURN IF(ISBLANK(d), "", "median stay  ·  " & FORMAT(DIVIDE(d, a) - 1, "+0%;-0%") & " vs " & FORMAT(a, "0.0") & " h all ports")
		displayFolder: 3 Sea
		lineageTag: e5a9ec24-b46f-5dfd-87bc-0148ddaad253

	measure 'Focus Long Text' = SUBSTITUTE(FORMAT([Focus Long Stays] + 0, "#,##0", "en-GB"), ",", UNICHAR(8239))
		displayFolder: 3 Sea
		lineageTag: c11f1033-273a-52f6-8745-f59988d62969

	measure 'Focus Long Sub' = "stays of 48 h or more  ·  " & FORMAT(DIVIDE([Focus Long Stays] + 0, [Focus Calls]), "0%")
		displayFolder: 3 Sea
		lineageTag: 20e94b58-9303-5192-8287-166367f05854

	measure 'Focus Ships Text' = SUBSTITUTE(FORMAT([Focus Port Ships], "#,##0", "en-GB"), ",", UNICHAR(8239))
		displayFolder: 3 Sea
		lineageTag: c12f3313-1bf6-532e-b5f0-4946c3c75233

	measure 'Focus Calls per Ship Sub' = "ships  ·  " & FORMAT(DIVIDE([Focus Calls], [Focus Port Ships]), "0.00") & " calls each"
		displayFolder: 3 Sea
		lineageTag: fe0cacee-217c-5819-8697-1f6c348da485

	measure 'Focus Calls Day Text' = SUBSTITUTE(FORMAT(DIVIDE([Focus Calls], [Days With Data]), "#,##0.0", "en-GB"), ",", UNICHAR(8239))
		displayFolder: 3 Sea
		lineageTag: 52d59e38-2696-5ef5-9f30-417e77cbb989

	measure 'Focus Calls Day Sub' = "calls a day  ·  #" & [Focus Port Rank] & " of " & SUBSTITUTE(FORMAT([Ports With Calls], "#,##0", "en-GB"), ",", UNICHAR(8239)) & " ports"
		displayFolder: 3 Sea
		lineageTag: a1bb8071-ca33-57f9-b454-51fbb6b76907

	measure 'Focus Port Rank' =
			VAR p = [Focus Port]
			VAR c = CALCULATE([Calls], REMOVEFILTERS(DimPort), DimPort[locode] = p)
			RETURN IF(ISBLANK(c), BLANK(), COUNTROWS(FILTER(ALL(DimPort[locode]), [Calls] > c)) + 1)
		formatString: 0
		displayFolder: 3 Sea
		lineageTag: d6d6a7e9-1bcd-5659-b783-96b7f56d47ce

	measure 'Ports With Calls' = COUNTROWS(FILTER(ALL(DimPort[locode]), NOT ISBLANK([Calls])))
		formatString: #,##0
		displayFolder: 3 Sea
		lineageTag: f5f38731-c0e0-5846-bb26-a53caf487d2e

	measure 'Band Color' = IF(SELECTEDVALUE(FactPortCalls[dwell_band]) = "48 h +", "#EB6834", "#1BAF7A")
		displayFolder: 3 Sea
		lineageTag: 7ad08edf-47dc-5844-bc47-a87c2cb2baa4

	measure 'Top Ports' =
			VAR N = SELECTEDVALUE(DimPort[port_label])
			VAR V = [Calls]
			RETURN IF(ISBLANK(N) || ISBLANK(V), BLANK(),
			    VAR R = RANKX(FILTER(ALLSELECTED(DimPort[port_label]), NOT ISBLANK([Calls])), [Calls], V, DESC)
			    RETURN IF(R <= 5, V))
		formatString: #,##0
		displayFolder: 3 Sea
		lineageTag: eab82827-c139-5017-b99e-bede9e9e7943

	measure 'Port Bar Color' = IF(SELECTEDVALUE(DimPort[locode]) = [Focus Port], "#16191D", "#1BAF7A")
		displayFolder: 3 Sea
		lineageTag: 54599673-d600-576a-8ab6-db89a7803724

	measure 'Top Stays h' =
			// 12 longest seagoing stays at the focus port (a stay that touches the data edges is a lower bound)
			VAR V = CALCULATE(SUM(FactPortCalls[duration_h]), FactPortCalls[is_seagoing] = TRUE(), NOT ISBLANK(FactPortCalls[locode]), TREATAS({[Focus Port]}, DimPort[locode]))
			VAR Longer = CALCULATE(COUNTROWS(FILTER(FactPortCalls, FactPortCalls[duration_h] > V)), ALLSELECTED(), FactPortCalls[is_seagoing] = TRUE(), NOT ISBLANK(FactPortCalls[locode]), TREATAS({[Focus Port]}, DimPort[locode]))
			RETURN IF(ISBLANK(V), BLANK(), IF(Longer + 0 < 12, V))
		formatString: #,##0.0
		displayFolder: 3 Sea
		lineageTag: dfc1673e-1db0-588e-a3c4-255ebd767ce3

	measure 'Bronze Rows' = SUM(FactQuality[bronze_rows])
		formatString: #,##0
		displayFolder: 4 Quality
		lineageTag: f4d3009f-333c-5607-b7fc-f8d7e0204fbb

	measure 'Silver Rows' = SUM(FactQuality[silver_rows])
