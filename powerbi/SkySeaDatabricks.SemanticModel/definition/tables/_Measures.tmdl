	measure 'Top Ship Stay h' =
			// each ship's longest single seagoing stay at the focus port; the 10 longest ships are kept
			VAR N = SELECTEDVALUE(DimShip[ship_label])
			VAR V = CALCULATE(MAX(FactPortCalls[duration_h]), FactPortCalls[is_seagoing] = TRUE(), NOT ISBLANK(FactPortCalls[locode]), TREATAS({[Focus Port]}, DimPort[locode]))
			RETURN IF(ISBLANK(N) || ISBLANK(V), BLANK(),
			    VAR R = RANKX(FILTER(ALLSELECTED(DimShip[ship_label]), NOT ISBLANK(CALCULATE(MAX(FactPortCalls[duration_h]), FactPortCalls[is_seagoing] = TRUE(), NOT ISBLANK(FactPortCalls[locode]), TREATAS({[Focus Port]}, DimPort[locode])))),
			        CALCULATE(MAX(FactPortCalls[duration_h]), FactPortCalls[is_seagoing] = TRUE(), NOT ISBLANK(FactPortCalls[locode]), TREATAS({[Focus Port]}, DimPort[locode])), V, DESC)
			    RETURN IF(R <= 10, V))
		formatString: #,##0
		displayFolder: 3 Sea
		lineageTag: 4a4ab498-4c52-55b5-8a90-f7cad1be30cb

	measure 'Focus Photo' =
			VAR ft = [Focus Type]
			VAR u = CALCULATE(MAX(AircraftPhoto[image]), AircraftPhoto[typecode] = ft)
			RETURN IF(ISBLANK(u), "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 256 144'><rect width='256' height='144' rx='10' fill='%23EEF1F4'/><text x='128' y='76' font-family='Segoe UI' font-size='11' fill='%238A94A1' text-anchor='middle'>No free photo for this type</text></svg>", u)
		displayFolder: 2 Aircraft
		lineageTag: 7512742a-53a9-51f8-b51c-fae033fa6e43
		dataCategory: ImageUrl

	measure 'Focus Photo Credit' =
			VAR ft = [Focus Type]
			RETURN CALCULATE(MAX(AircraftPhoto[credit]), AircraftPhoto[typecode] = ft) & ""
		displayFolder: 2 Aircraft
		lineageTag: 7a35c86f-a397-56d0-b91b-b1e55973b06d

