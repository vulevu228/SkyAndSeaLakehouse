table _Measures
	lineageTag: cce6d3c6-4b74-5f18-a4f2-56f7a04092b6

	measure 'Aircraft Seen' = DISTINCTCOUNT(FactAircraftDaily[icao24])
		formatString: #,##0
		displayFolder: 1 Pulse
		lineageTag: dbd2f4bf-5c0e-563d-816a-8fe7ffa9f57c

	measure 'Ships Seen' = CALCULATE(DISTINCTCOUNT(FactShipDaily[mmsi]), DimShip[mmsi_kind] = "ship")
		formatString: #,##0
		displayFolder: 1 Pulse
		lineageTag: 8bf9b5a2-731d-534e-83fa-c6b4763e330e

	measure 'Days With Data' = COUNTROWS(FILTER(VALUES(DimDate[date_key]), NOT ISBLANK([Aircraft Seen]) || NOT ISBLANK([Ships Seen])))
		formatString: 0
		displayFolder: 1 Pulse
		lineageTag: 1ba075bb-99f9-5bc7-baf8-f000a0900d74

	measure 'Aircraft per Day' = AVERAGEX(VALUES(DimDate[date_key]), [Aircraft Seen])
		formatString: #,##0
		displayFolder: 1 Pulse
		lineageTag: dcf33a5a-37a8-50ac-a2b3-1df46f97bf1c

	measure 'Ships per Day' = AVERAGEX(VALUES(DimDate[date_key]), [Ships Seen])
		formatString: #,##0
		displayFolder: 1 Pulse
		lineageTag: d2cc636a-fedb-5e10-b5f2-d726afe934ec

	measure 'Airborne per Hour' = AVERAGE(FactTrafficHourly[aircraft_airborne])
		formatString: #,##0
		displayFolder: 1 Pulse
		lineageTag: 9f6901a9-bc24-5204-9221-b88f7a5a7886

	measure 'Ships Moving per Hour' = AVERAGE(FactTrafficHourly[ships_moving])
		formatString: #,##0
		displayFolder: 1 Pulse
		lineageTag: 82db64b8-ff07-5824-a465-096e7ea4e947

	measure 'Ships per Hour' = AVERAGE(FactTrafficHourly[ships])
		formatString: #,##0
		displayFolder: 1 Pulse
		lineageTag: 78aa14a9-2f4f-5988-8cba-9b9d836fa17c

	measure 'Moving Share' = DIVIDE([Ships Moving per Hour], [Ships per Hour])
		formatString: 0%
		displayFolder: 1 Pulse
		lineageTag: 2bd137ad-a2a4-5c5c-89e2-1f0e54247ede

	measure 'Air Peak Hour' = MAXX(TOPN(1, VALUES(FactTrafficHourly[hour_of_day]), [Airborne per Hour], DESC), FactTrafficHourly[hour_of_day])
		formatString: 0
		displayFolder: 1 Pulse
		lineageTag: 8b85e66c-2e6a-51b6-bb9f-48f04cfd6c2d

	measure 'Air Low Hour' = MAXX(TOPN(1, VALUES(FactTrafficHourly[hour_of_day]), [Airborne per Hour], ASC), FactTrafficHourly[hour_of_day])
		formatString: 0
		displayFolder: 1 Pulse
		lineageTag: 1979fb4a-6d23-5a74-ab2f-d3aac77dfa94

	measure 'Air Peak Value' = MAXX(VALUES(FactTrafficHourly[hour_of_day]), [Airborne per Hour])
		formatString: #,##0
		displayFolder: 1 Pulse
		lineageTag: 241c09dc-9324-5a1a-a4c6-d08ffed0a372

	measure 'Air Low Value' = MINX(VALUES(FactTrafficHourly[hour_of_day]), [Airborne per Hour])
		formatString: #,##0
		displayFolder: 1 Pulse
		lineageTag: 6285d0d1-540e-5406-a477-fa3ef3e0c75d

	measure 'Air Hour Color' = IF(SELECTEDVALUE(FactTrafficHourly[hour_of_day]) = CALCULATE([Air Peak Hour], ALLSELECTED(FactTrafficHourly[hour_of_day])), "#16191D", "#2A78D6")
		displayFolder: 1 Pulse
		lineageTag: 1d37a3c1-7bd5-5041-b950-8544bc73076b

	measure 'Sea Peak Hour' = MAXX(TOPN(1, VALUES(FactTrafficHourly[hour_of_day]), [Ships Moving per Hour], DESC), FactTrafficHourly[hour_of_day])
		formatString: 0
		displayFolder: 1 Pulse
		lineageTag: 11c8576a-3271-5a11-a6cf-435ca1ae9c45

	measure 'Sea Low Hour' = MAXX(TOPN(1, VALUES(FactTrafficHourly[hour_of_day]), [Ships Moving per Hour], ASC), FactTrafficHourly[hour_of_day])
		formatString: 0
		displayFolder: 1 Pulse
		lineageTag: ebb732d3-d90a-55ed-a3ff-e8ca4f322215

	measure 'Sea Peak Value' = MAXX(VALUES(FactTrafficHourly[hour_of_day]), [Ships Moving per Hour])
		formatString: #,##0
		displayFolder: 1 Pulse
		lineageTag: a30e6bd3-128a-5e86-8b53-6f75d4d64b3a

	measure 'Sea Low Value' = MINX(VALUES(FactTrafficHourly[hour_of_day]), [Ships Moving per Hour])
		formatString: #,##0
		displayFolder: 1 Pulse
		lineageTag: 28d51b57-6c39-58bd-9488-fe1ff8905735

	measure 'Sea Hour Color' = IF(SELECTEDVALUE(FactTrafficHourly[hour_of_day]) = CALCULATE([Sea Peak Hour], ALLSELECTED(FactTrafficHourly[hour_of_day])), "#16191D", "#1BAF7A")
		displayFolder: 1 Pulse
		lineageTag: 5a7bcd37-b989-56b5-b5fe-55b5b3cc0506

	measure 'Air Hero Text' = SUBSTITUTE(FORMAT([Airborne per Hour], "#,##0", "en-GB"), ",", UNICHAR(8239))
		displayFolder: 1 Pulse
		lineageTag: 4482269c-9485-52a1-9d53-8b48d8d1f054

	measure 'Sea Hero Text' = SUBSTITUTE(FORMAT([Ships Moving per Hour], "#,##0", "en-GB"), ",", UNICHAR(8239))
		displayFolder: 1 Pulse
		lineageTag: ab2160d1-4133-5762-8085-9ade2a507a2a

	measure 'Air Hero Sub' = "peak " & SUBSTITUTE(FORMAT([Air Peak Value], "#,##0", "en-GB"), ",", UNICHAR(8239)) & " at " & FORMAT([Air Peak Hour], "00") & ":00 · low " & SUBSTITUTE(FORMAT([Air Low Value], "#,##0", "en-GB"), ",", UNICHAR(8239)) & " at " & FORMAT([Air Low Hour], "00") & ":00 UTC"
		displayFolder: 1 Pulse
		lineageTag: 704e79a6-0db1-56f9-959c-652eacbf35ea

	measure 'Sea Hero Sub' = FORMAT([Moving Share], "0%") & " of " & SUBSTITUTE(FORMAT([Ships per Hour], "#,##0", "en-GB"), ",", UNICHAR(8239)) & " ships under way · peak " & FORMAT([Sea Peak Hour], "00") & ":00 UTC"
		displayFolder: 1 Pulse
		lineageTag: 3ee9e49d-89f1-5b66-bcc5-7d9ac4c85c0f

	measure 'Weekend Air Change' =
			VAR wd = CALCULATE([Aircraft per Day], DimDate[is_weekend] = FALSE())
			VAR we = CALCULATE([Aircraft per Day], DimDate[is_weekend] = TRUE())
			RETURN IF(ISBLANK(wd) || ISBLANK(we), BLANK(), DIVIDE(we - wd, wd))
		formatString: +0%;-0%;0%
		displayFolder: 1 Pulse
		lineageTag: 74db10e7-39ed-5402-bb11-7fefb3c3921e

	measure 'Weekend Sea Change' =
			VAR wd = CALCULATE([Ships per Day], DimDate[is_weekend] = FALSE())
			VAR we = CALCULATE([Ships per Day], DimDate[is_weekend] = TRUE())
			RETURN IF(ISBLANK(wd) || ISBLANK(we), BLANK(), DIVIDE(we - wd, wd))
		formatString: +0%;-0%;0%
		displayFolder: 1 Pulse
		lineageTag: e79ef7ec-a9ee-5293-b1c8-458ad156b6f0

	measure 'Weekend Air Text' = IF(ISBLANK([Weekend Air Change]), "–", FORMAT([Weekend Air Change], "+0%;-0%;0%"))
		displayFolder: 1 Pulse
		lineageTag: 56be1209-6ca1-5037-94f8-bf4fa463d3d8

	measure 'Weekend Sea Text' = IF(ISBLANK([Weekend Sea Change]), "–", FORMAT([Weekend Sea Change], "+0%;-0%;0%"))
		displayFolder: 1 Pulse
		lineageTag: 19fe94d7-82bb-52a0-a9f2-825b7b6679f0

	measure 'Weekend Air Sub' = SUBSTITUTE(FORMAT(CALCULATE([Aircraft per Day], DimDate[is_weekend] = TRUE()), "#,##0", "en-GB"), ",", UNICHAR(8239)) & " a weekend day vs " & SUBSTITUTE(FORMAT(CALCULATE([Aircraft per Day], DimDate[is_weekend] = FALSE()), "#,##0", "en-GB"), ",", UNICHAR(8239)) & " a weekday"
		displayFolder: 1 Pulse
		lineageTag: f840e50b-e284-54bf-a3d2-9337b284089e

	measure 'Weekend Sea Sub' = SUBSTITUTE(FORMAT(CALCULATE([Ships per Day], DimDate[is_weekend] = TRUE()), "#,##0", "en-GB"), ",", UNICHAR(8239)) & " a weekend day vs " & SUBSTITUTE(FORMAT(CALCULATE([Ships per Day], DimDate[is_weekend] = FALSE()), "#,##0", "en-GB"), ",", UNICHAR(8239)) & " a weekday"
		displayFolder: 1 Pulse
		lineageTag: 2563284f-04e0-5a89-a166-f8dec6b694e0

	measure 'Busiest Day Text' =
			VAR d = MAXX(TOPN(1, VALUES(DimDate[date_key]), [Aircraft Seen], DESC), DimDate[date_key])
			VAR v = CALCULATE([Aircraft Seen], DimDate[date_key] = d)
			RETURN "Busiest sky: " & CALCULATE(MAX(DimDate[day_label]), DimDate[date_key] = d) & " · " & SUBSTITUTE(FORMAT(v, "#,##0", "en-GB"), ",", UNICHAR(8239)) & " aircraft, " & FORMAT(DIVIDE(v, [Aircraft per Day]) - 1, "+0%;-0%") & " vs the average day"
		displayFolder: 1 Pulse
		lineageTag: 064d22ad-1ba5-5635-a159-894bec9f5087

	measure 'Period Text' = "Raspberry Pi collectors · " & FORMAT(MIN(DimDate[date]), "d mmm") & " – " & FORMAT(MAX(DimDate[date]), "d mmm yyyy") & " · " & [Days With Data] & " days · all times UTC"
		displayFolder: 1 Pulse
		lineageTag: 0e88d2a1-9b98-51d1-b36c-6da7c4f11d89

	measure 'Type Aircraft' = DISTINCTCOUNT(FactAircraftDaily[icao24])
		formatString: #,##0
		displayFolder: 2 Aircraft
		lineageTag: 08bb6e24-1716-5bac-99c2-2c27249ef7fc

	measure 'Focus Type' =
			VAR sel = SELECTEDVALUE(DimAircraftType[typecode])
			VAR best = MAXX(TOPN(1, FILTER(VALUES(DimAircraftType[typecode]), DimAircraftType[typecode] <> "UNKN" && CALCULATE(COUNTROWS(DimAircraftType), DimAircraftType[has_dimensions] = TRUE()) > 0), [Type Aircraft], DESC), DimAircraftType[typecode])
			VAR any = MAXX(TOPN(1, FILTER(VALUES(DimAircraftType[typecode]), DimAircraftType[typecode] <> "UNKN"), [Type Aircraft], DESC), DimAircraftType[typecode])
			RETURN IF(NOT ISBLANK(sel) && sel <> "UNKN", sel, IF(ISBLANK(best), any, best))
		displayFolder: 2 Aircraft
		lineageTag: 4fe2b700-54bb-58e5-9d55-97eed47f5c9e

	measure 'Focus Model' =
			VAR ft = [Focus Type]
			RETURN CALCULATE(MAX(DimAircraftType[model_name]), REMOVEFILTERS(DimAircraftType), DimAircraftType[typecode] = ft)
		displayFolder: 2 Aircraft
		lineageTag: afbffc5e-d174-522e-ac0d-cb106909bfd5

	measure 'Focus Class Chip' =
			VAR ft = [Focus Type]
			RETURN UPPER(CALCULATE(MAX(DimAircraftType[aircraft_class]), REMOVEFILTERS(DimAircraftType), DimAircraftType[typecode] = ft)) & "  ·  " & CALCULATE(MAX(DimAircraftType[manufacturer]), REMOVEFILTERS(DimAircraftType), DimAircraftType[typecode] = ft) & "  ·  " & ft
		displayFolder: 2 Aircraft
		lineageTag: ca22717d-42c9-569a-b15b-335aeed966ca

	measure 'Focus Dims Text' =
			VAR ft = [Focus Type]
			VAR S = CALCULATE(MAX(DimAircraftType[wingspan_m]), REMOVEFILTERS(DimAircraftType), DimAircraftType[typecode] = ft)
			VAR L = CALCULATE(MAX(DimAircraftType[length_m]), REMOVEFILTERS(DimAircraftType), DimAircraftType[typecode] = ft)
			VAR Ht = CALCULATE(MAX(DimAircraftType[tail_height_m]), REMOVEFILTERS(DimAircraftType), DimAircraftType[typecode] = ft)
			RETURN IF(ISBLANK(S), "Dimensions not in the FAA database", "L " & FORMAT(L, "0.0") & "  ·  W " & FORMAT(S, "0.0") & "  ·  H " & FORMAT(Ht, "0.0") & " m")
		displayFolder: 2 Aircraft
		lineageTag: f504b722-1a92-52ec-8068-08da67ca6b7e

	measure 'Focus Sub Text' =
			VAR ft = [Focus Type]
			VAR T = CALCULATE(MAX(DimAircraftType[mtow_kg]), REMOVEFILTERS(DimAircraftType), DimAircraftType[typecode] = ft)
			VAR N = CALCULATE(MAX(DimAircraftType[engines]), REMOVEFILTERS(DimAircraftType), DimAircraftType[typecode] = ft)
			VAR Eng = CALCULATE(MAX(DimAircraftType[engine_type]), REMOVEFILTERS(DimAircraftType), DimAircraftType[typecode] = ft)
			VAR Wt = CALCULATE(MAX(DimAircraftType[wtc]), REMOVEFILTERS(DimAircraftType), DimAircraftType[typecode] = ft)
			RETURN IF(ISBLANK(T), "", FORMAT(T / 1000, "#,##0.0") & " t max take-off  ·  ") & N & " × " & Eng & "  ·  wake category " & Wt
		displayFolder: 2 Aircraft
		lineageTag: ae6825bb-d873-5de1-9a48-040ba782647b

	measure 'Focus Seen' =
			VAR ft = [Focus Type]
			RETURN CALCULATE([Type Aircraft], REMOVEFILTERS(DimAircraftType), DimAircraftType[typecode] = ft)
		formatString: #,##0
		displayFolder: 2 Aircraft
		lineageTag: 41975060-2c01-5fbc-993a-cf0e036e0b18

	measure 'Focus Seen Text' =
			VAR share = DIVIDE([Focus Seen], CALCULATE([Type Aircraft], REMOVEFILTERS(DimAircraftType)))
			RETURN SUBSTITUTE(FORMAT([Focus Seen], "#,##0", "en-GB"), ",", UNICHAR(8239)) & " seen  ·  1 in " & FORMAT(DIVIDE(1, share), "#,##0") & " aircraft"
		displayFolder: 2 Aircraft
		lineageTag: 2a0c0371-84e0-50e3-a6cc-d615c5478d21

	measure 'Focus Cruise Text' =
			VAR ft = [Focus Type]
			VAR spd = CALCULATE(AVERAGE(FactAircraftDaily[avg_airborne_speed_kmh]), REMOVEFILTERS(DimAircraftType), DimAircraftType[typecode] = ft)
			VAR alt = CALCULATE(MEDIAN(FactAircraftDaily[max_baro_altitude_m]), REMOVEFILTERS(DimAircraftType), DimAircraftType[typecode] = ft)
			RETURN "Flies " & FORMAT(spd, "#,##0") & " km/h  ·  tops out at " & FORMAT(alt, "#,##0") & " m"
		displayFolder: 2 Aircraft
		lineageTag: 02983777-4249-5495-8842-3a98074db948

	measure 'Focus Gate Text' =
			VAR ft = [Focus Type]
			VAR S = CALCULATE(MAX(DimAircraftType[wingspan_m]), REMOVEFILTERS(DimAircraftType), DimAircraftType[typecode] = ft)
			VAR code = SWITCH(TRUE(), S < 15, "A", S < 24, "B", S < 36, "C", S < 52, "D", S < 65, "E", S < 80, "F", "–")
			RETURN IF(ISBLANK(S), "", "Fits ICAO code " & code & " stands  ·  " & SWITCH(code, "A", "under 15 m", "B", "under 24 m", "C", "under 36 m", "D", "under 52 m", "E", "under 65 m", "F", "under 80 m", "") & " span")
		displayFolder: 2 Aircraft
		lineageTag: d786d2f7-8b11-5b3f-9806-b6810ab53a4a

	measure 'Focus Silhouette' =
			VAR ft = [Focus Type]
			VAR S = CALCULATE(MAX(DimAircraftType[wingspan_m]), REMOVEFILTERS(DimAircraftType), DimAircraftType[typecode] = ft)
			VAR L = CALCULATE(MAX(DimAircraftType[length_m]), REMOVEFILTERS(DimAircraftType), DimAircraftType[typecode] = ft)
			VAR Eng = CALCULATE(MAX(DimAircraftType[engine_type]), REMOVEFILTERS(DimAircraftType), DimAircraftType[typecode] = ft)
			VAR N = CALCULATE(MAX(DimAircraftType[engines]), REMOVEFILTERS(DimAircraftType), DimAircraftType[typecode] = ft)
			VAR jet = Eng = "Jet"
			VAR pf = MAX(1.2, L * 0.075)
			VAR py0 = -L * 0.08
			VAR pcr = L * 0.2
			VAR psw = IF(jet, S / 2 * 0.5, S / 2 * 0.08)
			VAR pct = pcr * 0.35
			VAR pyt = L / 2 - L * 0.17
			VAR phs = MAX(S * 0.17, L * 0.14)
			VAR ptc = L * 0.1
			VAR ptsw = IF(jet, phs * 0.6, phs * 0.1)
			VAR gf = MAX(1.2, 37.6 * 0.075)
			VAR gy0 = -37.6 * 0.08
			VAR gcr = 37.6 * 0.2
			VAR gsw = IF(TRUE(), 35.8 / 2 * 0.5, 35.8 / 2 * 0.08)
			VAR gct = gcr * 0.35
			VAR gyt = 37.6 / 2 - 37.6 * 0.17
			VAR ghs = MAX(35.8 * 0.17, 37.6 * 0.14)
			VAR gtc = 37.6 * 0.1
			VAR gtsw = IF(TRUE(), ghs * 0.6, ghs * 0.1)
			VAR E = MAX(MAX(S, L), 37.6) * 1.18
			VAR fs = E * 0.058
			RETURN "data:image/svg+xml;utf8," & IF(ISBLANK(S) || ISBLANK(L), "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 440 220'>" & "<text x='" & FORMAT(220, "0.00", "en-US") & "' y='" & FORMAT(110, "0.00", "en-US") & "' font-family='Segoe UI' font-size='" & FORMAT(14, "0.00", "en-US") & "' font-weight='400' fill='%238A94A1' text-anchor='middle'>" & "No FAA dimensions for this type" & "</text>" & "</svg>",
			    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='" & FORMAT(-E, "0.00", "en-US") & " " & FORMAT(-E/2, "0.00", "en-US") & " " & FORMAT(2*E, "0.00", "en-US") & " " & FORMAT(E, "0.00", "en-US") & "'>" & "<g fill='%2316191D'>" & "<polygon points='" & FORMAT(pf/2, "0.00", "en-US") & "," & FORMAT(py0, "0.00", "en-US") & " " & FORMAT(S/2, "0.00", "en-US") & "," & FORMAT(py0+psw, "0.00", "en-US") & " " & FORMAT(S/2, "0.00", "en-US") & "," & FORMAT(py0+psw+pct, "0.00", "en-US") & " " & FORMAT(pf/2, "0.00", "en-US") & "," & FORMAT(py0+pcr, "0.00", "en-US") & " " & FORMAT(-(pf/2), "0.00", "en-US") & "," & FORMAT(py0+pcr, "0.00", "en-US") & " " & FORMAT(-(S/2), "0.00", "en-US") & "," & FORMAT(py0+psw+pct, "0.00", "en-US") & " " & FORMAT(-(S/2), "0.00", "en-US") & "," & FORMAT(py0+psw, "0.00", "en-US") & " " & FORMAT(-(pf/2), "0.00", "en-US") & "," & FORMAT(py0, "0.00", "en-US") & "'/>" & "<polygon points='" & FORMAT(pf*0.3, "0.00", "en-US") & "," & FORMAT(pyt, "0.00", "en-US") & " " & FORMAT(phs, "0.00", "en-US") & "," & FORMAT(pyt+ptsw, "0.00", "en-US") & " " & FORMAT(phs, "0.00", "en-US") & "," & FORMAT(pyt+ptsw+ptc*0.45, "0.00", "en-US") & " " & FORMAT(pf*0.3, "0.00", "en-US") & "," & FORMAT(pyt+ptc, "0.00", "en-US") & " " & FORMAT(-(pf*0.3), "0.00", "en-US") & "," & FORMAT(pyt+ptc, "0.00", "en-US") & " " & FORMAT(-(phs), "0.00", "en-US") & "," & FORMAT(pyt+ptsw+ptc*0.45, "0.00", "en-US") & " " & FORMAT(-(phs), "0.00", "en-US") & "," & FORMAT(pyt+ptsw, "0.00", "en-US") & " " & FORMAT(-(pf*0.3), "0.00", "en-US") & "," & FORMAT(pyt, "0.00", "en-US") & "'/>" & "<rect x='" & FORMAT(-pf/2, "0.00", "en-US") & "' y='" & FORMAT(-L/2, "0.00", "en-US") & "' width='" & FORMAT(pf, "0.00", "en-US") & "' height='" & FORMAT(L, "0.00", "en-US") & "' rx='" & FORMAT(pf/2, "0.00", "en-US") & "'/>" & IF(jet || Eng = "Turboprop/Turboshaft", "<ellipse cx='" & FORMAT(S*0.18, "0.00", "en-US") & "' cy='" & FORMAT(py0+psw*0.36-L*0.02, "0.00", "en-US") & "' rx='" & FORMAT(pf*0.32, "0.00", "en-