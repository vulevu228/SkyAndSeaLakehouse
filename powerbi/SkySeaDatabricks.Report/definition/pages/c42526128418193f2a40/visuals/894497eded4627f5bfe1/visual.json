    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How the data gets here",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "13pt",
                      "color": "#111418"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "6pt",
                      "color": "#8A94A1"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "1  Land. ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9pt",
                      "color": "#111418"
                    }
                  },
                  {
                    "value": "The Raspberry Pi collects OpenSky and AIS 24/7; daily .csv.gz files are uploaded to a Unity Catalog volume.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#4F5865"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "2  Bronze. ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9pt",
                      "color": "#111418"
                    }
                  },
                  {
                    "value": "Auto Loader streams only new files, every value kept as text.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#4F5865"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "3  Silver. ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9pt",
                      "color": "#111418"
                    }
                  },
                  {
                    "value": "Typed columns. Drop rules: bad ICAO/MMSI, no position, out of range, 0/0. Warn rules keep the row and flag it: stale fixes, impossible speeds.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#4F5865"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "4  Gold. ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9pt",
                      "color": "#111418"
                    }
                  },
                  {
                    "value": "Star schema plus port calls (gaps-and-islands), enriched with the OpenSky registry, ICAO Doc 8643 and FAA sizes.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#4F5865"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "5  Serve. ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9pt",
                      "color": "#111418"
                    }
                  },
                  {
                    "value": "A file-arrival Job reruns the pipeline; Power BI imports gold through the SQL Warehouse.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#4F5865"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "6pt",
                      "color": "#8A94A1"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Volunteer receivers, not official counts. Port calls match the local Polars build within 0.1 %.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8pt",
                      "color": "#8A94A1"
                    }
                  }
                ]
              }
            ]
          }
        }
